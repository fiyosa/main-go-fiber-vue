{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/AGENTS.md"],
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },

    { "action": "skill", "resource": "caveman", "effect": "allow" },
    { "action": "skill", "resource": "caveman-commit", "effect": "allow" },
    { "action": "skill", "resource": "caveman-review", "effect": "allow" },
    { "action": "skill", "resource": "caveman-help", "effect": "allow" },
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 20000 },
    "buffer": 4000,
  },
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp",
          //
          // "--no-watch",
        ],
        "disabled": false,
      },
      "app-db": {
        "type": "remote",
        "url": "{file:mcp-url}",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:mcp-token}",
        },
        "disabled": false,
      },
    },
  },
}
