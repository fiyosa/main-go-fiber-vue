{
  "languages": {
    "JSON": {
      "language_servers": [
        "!package-version-server",
        "json-language-server",
        "...",
      ],
      "prettier": { "allowed": true, "tab_size": 2 },
    },
    "JSONC": {
      "language_servers": [
        "!package-version-server",
        "json-language-server",
        "...",
      ],
      "prettier": { "allowed": true, "tab_size": 2 },
    },
    "JavaScript": {
      "language_servers": [
        "!eslint",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "!vtsls",
        "...",
      ],
      "prettier": { "allowed": true },
    },
    "TypeScript": {
      "language_servers": [
        "!eslint",
        "!tailwindcss-language-server",
        "!typescript-language-server",
        "vtsls",
        "...",
      ],
      "prettier": { "allowed": true },
    },
    "Vue.js": {
      "language_servers": [
        "!eslint",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "vue-language-server",
        "vtsls",
        "...",
      ],
      "prettier": { "allowed": true },
    },
    "Go": {
      "language_servers": ["gopls", "..."],
      "prettier": { "allowed": true },
    },
  },
}
