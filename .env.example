# Copy this file to .env and adjust the values for your machine.
# Real environment variables always override values from .env.

# --- Application -------------------------------------------------------------
# development | local | production
APP_ENV=development
APP_PORT=8080
# en | id
APP_LOCALE=en
# true blocks all requests with 503 and a maintenance message.
APP_MAINTENANCE=false
# Comma-separated browser origins allowed to call the API cross-origin.
APP_CORS_ORIGINS=http://localhost:5173


# --- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=go_fiber_vue
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable
# true logs every executed SQL statement; false keeps warnings and errors only.
DB_LOG_SQL=false
# --- JWT ---------------------------------------------------------------------
# Shared secret for HS256 signing. Use a long random value in production, for
# example: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=3h
JWT_REFRESH_TTL=720h

# --- Hashids -----------------------------------------------------------------
# Salt used to encode numeric ids in API payloads. Required when APP_ENV is
# production (any value other than development/local). Development falls back to
# a fixed salt when this is empty.
# Generate one with: openssl rand -hex 32
# Keep it stable: rotating the salt invalidates every id already handed out.
HASHID_SALT=
# Minimum length of the encoded id string.
HASHID_MIN_LENGTH=8

# --- MCP ---------------------------------------------------------------------
# Raw SQL access as the DB_* user; treat the token as full database access.
# Generate with: openssl rand -hex 32
MCP_ENABLED=false
MCP_TOKEN=dev-mcp-token-change-me

# --- Object storage (S3-compatible / Garage) ---------------------------------
# Optional. Leave STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY empty to disable the
# storage layer; the API still starts without it.
STORAGE_ENDPOINT=http://127.0.0.1:3900
STORAGE_REGION=garage
STORAGE_BUCKET=app
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Garage and most self-hosted stores require path-style addressing.
STORAGE_PATH_STYLE=true

# --- Frontend ---------------------------------------------------------------
# Vite only exposes VITE_-prefixed vars to the client. VITE_APP_ENV mirrors
# APP_ENV so the frontend and backend share one mode definition.
VITE_APP_ENV="${APP_ENV}"
VITE_API_URL=http://localhost:${APP_PORT}
VITE_SHOW_SERVER=true

# --- Cron Engine ---
# Enable the cron job engine. Disabled by default.
CRON_ENABLED=false
# Required when CRON_ENABLED=true. Used to encrypt/decrypt cron env secrets (AES-256-GCM).
# Generate one with: openssl rand -base64 32
CRON_SECRET_KEY=
