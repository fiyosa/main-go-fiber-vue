# Copy this file to .env and adjust the values for your machine.
# Real environment variables always override values from .env.

# --- Application -------------------------------------------------------------
# development | local | production
APP_ENV=development
APP_PORT=8080
# en | id
APP_LOCALE=en
# true blocks all requests with 503 and a maintenance message.
APP_MAINTENANCE=false


# --- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=go_fiber_vue
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable
# true logs every executed SQL statement; false keeps warnings and errors only.
DB_LOG_SQL=false
# --- JWT ---------------------------------------------------------------------
# Shared secret for HS256 signing. Use a long random value in production, for
# example: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=3h
JWT_REFRESH_TTL=720h

# --- MCP ---------------------------------------------------------------------
# Read-only Model Context Protocol server on the same port as the HTTP API.
# true mounts the endpoint; false skips registration entirely.
MCP_ENABLED=true
# Streamable HTTP endpoint path.
MCP_PATH=/api/mcp
# Static bearer token. Required when MCP_ENABLED=true; startup fails otherwise.
# Generate one with: openssl rand -base64 48
MCP_BEARER_TOKEN=dev-mcp-token-change-me
# Optional local user ID used as the tool actor; tools that need an identity
# fail when this is empty.
MCP_ACTOR_USER_ID=
# Granted scopes for the static token; mcp:write is reserved for mutating tools.
MCP_SCOPES=mcp:read
# Request body size limit in bytes (1 MiB).
MCP_MAX_BODY_BYTES=1048576
# Comma-separated Origin allowlist. Empty allows requests without an Origin.
MCP_ALLOWED_ORIGINS=
# Idle timeout for a session.
MCP_SESSION_TIMEOUT=60s
# true keeps no server-side session state (recommended behind a load balancer).
MCP_STATELESS=true

# Issuer and audience are fixed in code (app-api / app-spa) and are not
# configurable through the environment.
